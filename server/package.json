{
  "name": "nile-booking-server",
  "version": "1.0.0",
  "description": "Nile Booking API Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "tokens:plan": "node scripts/backfillPublicTokens.js --plan",
    "tokens:dry-run": "node scripts/backfillPublicTokens.js",
    "tokens:backfill": "node scripts/backfillPublicTokens.js --apply"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testEnvironment": "node"
  },
  "keywords": [
    "booking",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.5.7",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "slugify": "^1.6.9",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "vercel": "^58.0.0"
  }
}
