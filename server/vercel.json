{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "api/index.js"
    },
    {
      "src": "/(.*)",
      "destination": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/availability/sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/notifications/reminders/check",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/domains/cron/maintenance",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/domains/cron/renewal-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
