# NILE BOOKING BACKEND PRODUCTION CONFIGURATION (VERCEL SERVERLESS)
NODE_ENV=production
PORT=5050

# DOMAINS
FRONTEND_URL=https://app.nilebooking.co
PUBLIC_SITE_URL=https://nilebooking.co
API_URL=https://api.nilebooking.co

# 1. DATABASE (MongoDB Atlas Cluster)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# 2. AUTHENTICATION & SECURITY (NO FALLBACKS)
# Required. Minimum 32 chars. Rotate any value that ever used a public fallback.
JWT_SECRET=replace_with_a_random_64_character_secret
JWT_EXPIRES_IN=7d
# Required. Minimum 24 chars. Rotating invalidates admin portal access.
ADMIN_MASTER_KEY=replace_with_a_random_48_character_admin_key
# Comma-separated exact origins. No wildcards or *.vercel.app patterns.
CORS_ORIGINS=https://app.nilebooking.co,https://nilebooking.co
# Used in customer booking links and emails.
CLIENT_URL=https://app.nilebooking.co

# 3. TRANSACTIONAL MAILING (Mailtrap HTTP API)
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_FROM_EMAIL=hello@nile.ng
MAILTRAP_FROM_NAME=Nile Booking

# 4. CLOUD MEDIA STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. BANKING & PAYMENTS (Paystack / Providus)
PAYSTACK_SECRET_KEY=your_paystack_live_secret_key
# Must return to the dashboard domains page, e.g. https://app.nilebooking.co/dashboard/domains
PAYSTACK_CALLBACK_URL=

# Custom domains (Premium). Set DOMAINS_ENABLED=false for an emergency stop.
DOMAINS_ENABLED=true
NAMECHEAP_ENV=sandbox
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX_API_USER=
NAMECHEAP_SANDBOX_API_KEY=
NAMECHEAP_SANDBOX_CLIENT_IP=
DOMAIN_DISPLAY_MARKUP=1.30
DOMAIN_CHECKOUT_MARKUP=0.20
DOMAIN_CHECKOUT_MARKUP_CAP_NGN=2000
DOMAIN_FX_FALLBACK=1650
DOMAIN_CONTACT_ENCRYPTION_KEY=
DOMAIN_RENEWAL_CALLBACK_URL=https://app.nilebooking.co/dashboard/domains
DOMAIN_APEX_IP=76.76.21.21
DOMAIN_WWW_CNAME=cname.vercel-dns.com
# Vercel project that serves the client storefront (not the API project)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
PAYSTACK_PUBLIC_KEY=your_paystack_live_public_key

# 6. SLOT HOLDS (defaults shown)
HOLD_MINUTES=30
CASH_HOLD_HOURS=24

# 7. CRON (protects sweep and reminder endpoints; no public fallback)
CRON_SECRET=replace_with_a_random_48_character_cron_secret
# Vercel Cron is the production scheduler. In-process cron is opt-in only.
ENABLE_IN_PROCESS_CRON=false

# 8. PAYMENT LIFECYCLE (defaults shown)
DEPOSIT_PERCENT=50
# Reminder windows.
HOLD_REMINDER_LEAD_MINUTES=15
APPOINTMENT_REMINDER_LEAD_MINUTES=1440
# Body and receipt guards (defaults shown). Receipt binary max is 5 MB.
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RECEIPT_BODY_LIMIT=7mb
RECEIPT_MAX_BYTES=5242880
MAILTRAP_TIMEOUT_MS=10000
CLOUDINARY_UPLOAD_TIMEOUT_MS=20000

# 9. DEMO DATA (both default to false; production refuses true)
PURGE_DEMO_DATA=false
ENABLE_DEMO_SEEDING=false
# Required only when the corresponding gateway is enabled.
PAYSTACK_CALLBACK_URL=https://app.nilebooking.co/checkout/callback
FLUTTERWAVE_CALLBACK_URL=https://app.nilebooking.co/checkout/callback
