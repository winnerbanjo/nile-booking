# NILE BOOKING BACKEND PRODUCTION CONFIGURATION (VERCEL SERVERLESS)
NODE_ENV=production
PORT=5050

# DOMAINS
FRONTEND_URL=https://app.nilebooking.co
PUBLIC_SITE_URL=https://nilebooking.co
API_URL=https://api.nilebooking.co

# 1. DATABASE (MongoDB Atlas Cluster)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# 2. AUTHENTICATION & SECURITY
JWT_SECRET=your_long_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# 3. TRANSACTIONAL MAILING (Mailtrap HTTP API)
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_FROM_EMAIL=hello@nile.ng
MAILTRAP_FROM_NAME=Nile Booking

# 4. CLOUD MEDIA STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. BANKING & PAYMENTS (Paystack / Providus)
PAYSTACK_SECRET_KEY=your_paystack_live_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_live_public_key
